{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "knowledge_id",
    "project_id",
    "candidate_version",
    "content_sha256",
    "source_manifest",
    "source_manifest_sha256",
    "method",
    "criteria",
    "commands",
    "verdict",
    "validated_by",
    "started_at",
    "completed_at",
    "valid_until",
    "report_artifact",
    "source_artifact"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "hybrid-ai/knowledge-validation/v1"
    },
    "knowledge_id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_version": {
      "type": "integer",
      "minimum": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "sources"
      ],
      "properties": {
        "schema_version": {
          "const": "hybrid-ai/knowledge-source/v1"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reference"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "repository",
                  "document",
                  "procedure",
                  "patch",
                  "work_packet"
                ]
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
              },
              "branch": {
                "type": "string",
                "minLength": 1
              },
              "applicable_through_revision": {"type":"string","pattern":"^[a-f0-9]{40}([a-f0-9]{24})?$"},
              "artifact_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "repository"
                    }
                  }
                },
                "then": {
                  "required": [
                    "revision",
                    "branch"
                  ]
                },
                "else": {
                  "required": [
                    "artifact_sha256"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "method": {
      "enum": [
        "manual",
        "workpacket"
      ]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed",
          "observation"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commands": {
      "type": [
        "array",
        "null"
      ],
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "argv",
          "exit_code",
          "output_sha256"
        ],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "exit_code": {
            "type": "integer"
          },
          "output_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "validated_by": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "report_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "uri",
        "media_type",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "uri",
        "media_type",
        "size_bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
