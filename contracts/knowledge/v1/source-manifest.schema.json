{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "hybrid-ai/knowledge-source/v1"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference"
        ],
        "properties": {
          "kind": {
            "enum": [
              "repository",
              "document",
              "procedure",
              "patch",
              "work_packet"
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "applicable_through_revision": {"type":"string","pattern":"^[a-f0-9]{40}([a-f0-9]{24})?$"},
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "repository"
                }
              }
            },
            "then": {
              "required": [
                "revision",
                "branch"
              ]
            },
            "else": {
              "required": [
                "artifact_sha256"
              ]
            }
          }
        ]
      }
    }
  }
}
