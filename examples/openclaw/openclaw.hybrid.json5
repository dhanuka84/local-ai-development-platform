// Merge these sections into ~/.openclaw/openclaw.json after onboarding.
// Secrets are environment references; do not replace them with literal keys in Git.
{
  plugins: {
    entries: {
      "hybrid-workflow-controller": {
        enabled: true,
        config: {
          mcpUrl: "http://127.0.0.1:8080/mcp",
          tokenEnv: "CONTROLLER_AUTH_TOKEN",
          controllerAgentIds: ["workflow-coordinator"],
          requestTimeoutMs: 30000
        }
      }
    }
  },

  models: {
    mode: "merge",
    providers: {
      ollama: {
        api: "ollama",
        apiKey: "ollama-local",
        baseUrl: "http://127.0.0.1:11434",
        timeoutSeconds: 300,
        models: [
          {
            id: "qwen3.6:35b",
            name: "Qwen 3.6 35B local coding",
            reasoning: true,
            input: ["text", "image"],
            contextWindow: 262144,
            maxTokens: 16384,
            params: { num_ctx: 65536, keep_alive: "15m" }
          }
        ]
      }
    }
  },

  agents: {
    defaults: {
      subagents: { maxSpawnDepth: 1 }
    },
    list: [
      {
        id: "workflow-coordinator",
        default: true,
        name: "Hybrid Workflow Coordinator",
        workspace: "~/.openclaw/workspace-coordinator",
        model: { primary: "ollama/qwen3.6:35b", fallbacks: [] },
        subagents: {
          requireAgentId: true,
          allowAgents: ["developer", "qa", "cloud-review"]
        },
        tools: {
          allow: [
            "hybrid_workflow_start",
            "hybrid_workflow_status",
            "hybrid_workflow_transition",
            "hybrid_workflow_cancel",
            "sessions_spawn",
            "lobster"
          ]
        }
      },
      {
        id: "developer",
        name: "Hybrid Developer",
        workspace: "~/.openclaw/workspace-developer",
        model: { primary: "ollama/qwen3.6:35b", fallbacks: [] },
        subagents: { allowAgents: ["cloud-review"] },
        tools: { profile: "coding" }
      },
      {
        id: "qa",
        name: "Independent Local QA",
        workspace: "~/.openclaw/workspace-qa",
        model: { primary: "ollama/qwen3.6:35b", fallbacks: [] },
        sandbox: { mode: "all", scope: "agent", workspaceAccess: "ro" },
        tools: { profile: "coding", deny: ["write", "edit", "apply_patch"] }
      },
      {
        id: "maintenance",
        name: "Local Maintenance",
        workspace: "~/.openclaw/workspace-maintenance",
        model: { primary: "ollama/qwen3.6:35b", fallbacks: [] },
        // A non-empty per-agent model catalog is an allowlist. This prevents
        // stored session overrides from switching maintenance to cloud.
        models: { "ollama/qwen3.6:35b": {} },
        tools: { profile: "coding" }
      },
      {
        id: "cloud-review",
        name: "Kimi Cloud Reviewer",
        workspace: "~/.openclaw/workspace-cloud-review",
        model: { primary: "moonshot/kimi-k3", fallbacks: [] },
        sandbox: { mode: "all", scope: "agent", workspaceAccess: "ro" },
        tools: { profile: "coding", deny: ["write", "edit", "apply_patch", "exec", "process"] }
      }
    ]
  },

  mcp: {
    servers: {
      hybridKnowledge: {
        url: "http://127.0.0.1:8080/mcp",
        transport: "streamable-http",
        headers: { Authorization: "Bearer ${CONTROLLER_AUTH_TOKEN}" },
        timeout: 120,
        connectTimeout: 10,
        supportsParallelToolCalls: true,
        toolFilter: {
          include: [
            "platform_status",
            "knowledge_search",
            "knowledge_get",
            "knowledge_candidates_list",
            "repository_graph_get",
            "repository_relation_search",
            "code_symbol_search",
            "code_graph_get",
            "code_repository_index",
            "generation_capture",
            "workflow_run_get"
          ]
        },
        codex: {
          // Cloud review receives only the context explicitly delegated by the
          // developer; it cannot query the unrestricted local MCP graph.
          agents: ["developer", "maintenance"],
          defaultToolsApprovalMode: "prompt"
        }
      }
    }
  }
}
