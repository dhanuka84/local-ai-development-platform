%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial, sans-serif","fontSize":"16px","primaryTextColor":"#14263d","lineColor":"#53677f","edgeLabelBackground":"#ffffff"},"flowchart":{"curve":"basis","htmlLabels":true,"nodeSpacing":28,"rankSpacing":40},"fontFamily":"Arial, sans-serif","themeCSS":".nodeLabel, .edgeLabel, .cluster-label, .flowchartTitleText { font-family: Arial, sans-serif !important; }"}}%%
flowchart LR
    subgraph ENTRY["GENERATED KB ENTRY · A FIX, PROCEDURE OR RECOMMENDATION"]
        GEN["Capture useful result<br/>procedure + exact evidence<br/>revision + provider + model"]:::client
        PENDING["Pending candidate<br/>source freshness + trusted validation<br/>exact version and digest"]:::pending
        USER{"User explicitly approves<br/>this exact version?"}:::gate
        KEEP["Keep pending<br/>continue independent work"]:::pending
        GEN --> PENDING --> USER
        USER -->|no decision| KEEP
    end
    subgraph DEF["GOVERNED DEFINITION · DOMAIN, CAPABILITY OR METRIC"]
        REG["Source-controlled registry<br/>fixed reviewed contracts / SQL"]:::client
        VAL["context_registry_validate<br/>contract fixtures + SQL preparation<br/>staged exact definition versions"]:::service
        DEC["context_definition_decide<br/>existing operator authority<br/>standing task authorization + audit"]:::gate
        REG --> VAL --> DEC
    end
    COMMIT["PostgreSQL<br/>attributed exact-version decision<br/>transactional outbox"]:::data
    SEARCH["Local worker → Milvus<br/>current approved records only<br/>hydrate from PostgreSQL before use"]:::done
    USER -->|explicit approval + valid evidence| COMMIT
    DEC -->|valid evidence + permitted actor| COMMIT
    COMMIT --> SEARCH
    NOTE["A model response or review does not approve either path.<br/>AUTO_APPROVE_LOCAL=true is rejected.<br/>Expired validation or changed source withdraws eligibility."]:::gate
    COMMIT -.- NOTE

