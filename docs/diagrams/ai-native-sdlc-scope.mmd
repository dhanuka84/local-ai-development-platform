%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial, sans-serif","fontSize":"17px","primaryTextColor":"#14263d","lineColor":"#53677f","edgeLabelBackground":"#ffffff"},"flowchart":{"curve":"basis","htmlLabels":true,"nodeSpacing":35,"rankSpacing":45},"themeCSS":".nodeLabel, .edgeLabel, .cluster-label, .flowchartTitleText { font-family: Arial, sans-serif !important; }"}}%%
flowchart TB
    HUMAN["People own outcomes and decisions<br/>Every agent has an accountable owner"]:::client

    subgraph PLATFORM["EXPECTED PLATFORM SCOPE — target capabilities"]
        CONTROL["Controls apply throughout<br/>Role identity · scoped access · budgets<br/>Audit reads, actions and decisions<br/>Include denials and failures"]:::gate
        PLAN["Discover · plan · specify<br/>Product/BRS and planning agents"]:::local
        BUILD["Design · implement · integrate<br/>Architecture and builder agents"]:::local
        TEST["Evaluate · accept · deliver<br/>QA, security and release agents"]:::local
        OPS["Operate · improve · retire<br/>Incident, maintenance and KB agents"]:::local
        MCP["Agent runtime + MCP gateway<br/>Plan / act / verify / resume<br/>Scoped tools and reconciled effects"]:::service

        subgraph KB["ONE SHARED PRODUCT KNOWLEDGE BASE"]
            PG["PostgreSQL authority<br/>Product · BRS · features · code<br/>Releases · operations · observations · incidents"]:::data
            GRAPH["Structural dimension · AGE<br/>Entities, relationships and versions"]:::data
            SEM["Semantic dimension · Milvus<br/>Meaning and approved experience"]:::data
        end

        INGEST["Evaluate evidence against the KB<br/>Validate · classify · link<br/>Preserve source, time and uncertainty"]:::gate
        PENDING["Generated conclusions and lessons<br/>Pending → local validation<br/>→ explicit exact-version approval"]:::pending
    end

    SOURCE["Source adapters<br/>BRS/docs · code · logs · metrics<br/>Kafka · lake · audit DB · incident history"]:::external
    DELIVERY["Delivery and operations<br/>Forge · CI · artifacts · environments<br/>Verify technical and business effects"]:::external

    HUMAN --> CONTROL
    CONTROL --> PLAN & BUILD & TEST & OPS
    PLAN & BUILD & TEST & OPS <--> MCP
    MCP -->|Bounded reads| SOURCE
    SOURCE -->|Minimized evidence| INGEST
    MCP -->|Current KB context| INGEST
    INGEST -->|Eligible observations under ingestion policy| PG
    INGEST --> PENDING -->|Publish and verify read-back| PG
    PG --> GRAPH
    PG --> SEM
    GRAPH -->|Hydrate current authorized records| MCP
    SEM -->|Hydrate current authorized records| MCP
    MCP -->|Separate action authority| DELIVERY
    DELIVERY -->|Observe outcome| SOURCE

