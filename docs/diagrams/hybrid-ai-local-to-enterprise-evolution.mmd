    subgraph KEEP["2 · CONTRACTS THAT REMAIN STABLE"]
        direction TB
        AUTH["Authenticated actor + project<br/>Cerbos + service validation<br/>exact version and evidence"]:::service
        DATA["PostgreSQL authority<br/>stable UUIDs + outbox<br/>hydrate every index hit"]:::data
        KB["Pending generated KB entries<br/>explicit user publication<br/>validated definitions use task authority"]:::gate
        AUTH ~~~ DATA ~~~ KB
    end
    subgraph FUTURE["3 · DEFERRED ACCEPTANCE"]
        direction TB
        LIVE["Live rollout<br/>unlock existing vault<br/>retained definition decisions + cutover"]:::target
        ADOPT["Adoption and ownership<br/>representative timed cohorts<br/>named owners + stage decisions"]:::target
        PROD["Target deployment<br/>identity / storage / retention<br/>tenant tests + HA / restore evidence"]:::target
        LIVE ~~~ ADOPT ~~~ PROD
    end
    LOCAL --> KEEP
    KEEP --> FUTURE
