    end

    subgraph ENTERPRISE["ENTERPRISE PROFILE · DISTRIBUTED"]
        direction TB
        ECLIENT["Workstations + CI/CD + edge sites"]:::enterprise
        EMCP["Stateless MCP/API gateway replicas"]:::enterprise
        EAGENT["Durable workflows + event bus<br/>sandboxed worker pools"]:::enterprise
        EMODEL["Private GPU inference cluster<br/>policy-gated Kimi/OpenAI review"]:::enterprise
        EPG[("PostgreSQL HA<br/>workflow + repository graph · multi-zone + DR")]:::enterpriseData
        EMILVUS[("Milvus Distributed<br/>knowledge + relation search · scaled query + ingestion")]:::enterpriseData
        ESTORE[("Enterprise Git + versioned object storage<br/>regional replication")]:::enterpriseData

        ECLIENT --> EMCP
        EMCP --> EAGENT
        EAGENT --> EMODEL
        EAGENT --> EPG
        EAGENT --> EMILVUS
        EAGENT --> ESTORE
