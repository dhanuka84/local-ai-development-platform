        C4["VectorIndex interface<br/>Milvus hidden behind retrieval service"]:::contract
        C5["ModelProvider interface<br/>local · private · cloud adapters"]:::contract
        C6["Canonical rebuild sources<br/>PostgreSQL graph + Git + object artifacts"]:::contract
