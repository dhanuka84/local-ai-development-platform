flowchart LR

    TASK["Software task"]:::user review1_task_router@--> ROUTER["OpenClaw<br/><b>classify · route · minimize</b>"]:::control
    TASK review1_task_codex@--> CODEXCLI["Optional Codex CLI work session<br/><b>implement · review · validate</b><br/>cloud disclosure policy applies"]:::client

    subgraph BUILD["1 · LOCAL DEVELOPMENT"]
        direction TB
        RETRIEVE["MCP retrieval<br/>approved lessons · repository graph · code graph"]:::gateway
        LOCAL["Ollama local worker<br/><b>implement</b>"]:::local
        VERIFY["Work-packet verifier<br/>scope · patch · tests · rollback"]:::verify
        RETRIEVE review1_implement@--> LOCAL
        LOCAL review1_verify@--> VERIFY
    end

    subgraph REVIEW["2 · EXPLICIT REMOTE REVIEW"]
        direction TB
        PACKAGE["Sanitized review package<br/>diff/snippets · checks · context manifest"]:::security
        CODEX["Codex<br/>code + diff review"]:::cloud
        KIMI["Kimi<br/>architecture + optimization"]:::cloud
        EVIDENCE["MCP review_record<br/>provenance · verdict · findings"]:::gateway
        PACKAGE review2_codex@--> CODEX
        CODEX review2_codex_evidence@--> EVIDENCE
        PACKAGE review2_kimi@--> KIMI
        KIMI review2_kimi_evidence@--> EVIDENCE
    end

    subgraph LEARN["3 · VALIDATE, APPROVE, AND LEARN"]
        direction TB
        PG[("PostgreSQL<br/><b>review + knowledge truth</b><br/>pending candidate · stable ID · outbox")]:::database
        REPRODUCE["Local acceptance loop<br/>reproduce · retest · generalize"]:::local
        APPROVE{"Accountable<br/>approval?"}:::decision
        OUTBOX["Transactional outbox<br/>knowledge.upsert"]:::service
        EMBED["Ollama embeddings"]:::local
        MILVUS[("Milvus<br/><b>approved semantic discovery</b><br/>PostgreSQL UUID")]:::vector
        PG review3_reproduce@--> REPRODUCE
        REPRODUCE review3_approve@--> APPROVE
        APPROVE review3_outbox@-->|"approve"| OUTBOX
        OUTBOX review3_embed@--> EMBED
        EMBED review3_milvus@--> MILVUS
    end

    subgraph LOCALONLY["4 · LOCAL-ONLY REUSE"]
        direction TB
        FUTURE["Similar future development task<br/>retrieve · adapt · revalidate"]:::local
        MAINT["Maintenance<br/>Ollama · no fallback · no cloud credentials"]:::maintenance
        MVERIFY["Local checks + operator gate"]:::verify
        MAINT review4_verify@--> MVERIFY
    end

    ROUTER review1_retrieve@-->|"1 · LOCAL BUILD"| RETRIEVE
    CODEXCLI review1_codex_retrieve@-->|"MCP retrieval"| RETRIEVE
    CODEXCLI review3_capture@-->|"generation_capture · pending"| PG
    VERIFY review2_package@-->|"2 · REMOTE REVIEW"| PACKAGE
    EVIDENCE review3_evidence@-->|"3 · VALIDATE / LEARN"| PG
    EVIDENCE review2_artifact@--> ARTIFACT["Immutable artifact evidence<br/>raw output + manifest · SHA-256"]:::artifact
    APPROVE review_reject@-->|"reject / revise"| HOLD["Remain pending<br/>or reject"]:::note
    MILVUS review4_future@-.->|"4 · APPROVED REUSE"| FUTURE
    MILVUS review4_maintenance@-.->|"approved lessons only"| MAINT
    ROUTER review4_route_maintenance@-->|"maintenance"| MAINT

    NOTE["Raw review is evidence.<br/><b>Only validated + generalized + approved improvements are embedded.</b>"]:::note
    ARTIFACT review_support_artifact@-.-> NOTE
    MILVUS review_support_milvus@-.-> NOTE

