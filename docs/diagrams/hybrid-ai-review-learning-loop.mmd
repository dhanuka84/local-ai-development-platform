flowchart LR

    subgraph QUEUE["1 · DURABLE FIFO QUEUE"]
        direction TB
        SUBMIT["workflow_task_begin<br/><b>accept every atomic task</b>"]:::control
        FIFO[("PostgreSQL task queue<br/>queued · ordered · auditable")]:::database
        HEAD{"Queue head<br/>available?"}:::decision
        REJECT["Explicit TASK_REJECTED<br/>human reason evidence"]:::reject
        SUBMIT --> FIFO --> HEAD
        FIFO -. "manual only" .-> REJECT
    end

    subgraph ROUTE["2 · ACTIVATE AND SEARCH RAG"]
        direction TB
        ACTIVATE["TASK_ACTIVATED<br/><b>lookup at execution time</b>"]:::control
        SEARCH["knowledge_search<br/>Milvus discovery + PostgreSQL hydration"]:::gateway
        MATCH{"Approved strong hit?"}:::decision
        POLICY{"Cloud disclosure<br/>allowed?"}:::decision
        HIT["rag_hit<br/>reuse validated lesson"]:::local
        MISS["rag_miss_cloud_review<br/>auto mode: no acceptance prompt"]:::cloud
        LOCALONLY["rag_miss_local_only<br/>maintenance / protected data"]:::maintenance
        ACTIVATE --> SEARCH --> MATCH
        MATCH -- yes --> HIT
        MATCH -- no --> POLICY
        POLICY -- yes --> MISS
        POLICY -- no --> LOCALONLY
    end

    subgraph WORK["3 · LOCAL OWNER, CONDITIONAL CLOUD REVIEW"]
        direction TB
        OLLAMA["Ollama local model<br/><b>design / implement / test</b>"]:::local
        CAPTURE["generation_capture<br/>pending candidate + immutable output"]:::gateway
        CLOUD["Codex cloud model<br/><b>read-only review</b><br/>no repository or candidate writes"]:::cloud
        RAW["review_record<br/>raw review + context hashes"]:::artifact
        REVISE["Ollama accepts findings<br/><b>revise locally</b>"]:::local
        HIT --> OLLAMA
        LOCALONLY --> OLLAMA
        MISS --> OLLAMA
        OLLAMA --> CAPTURE
        CAPTURE -->|"allowed RAG miss"| CLOUD --> RAW --> REVISE
    end

    subgraph LEARN["4 · VALIDATE, PROMOTE, PROVE"]
        direction TB
        VALIDATE["Local deterministic validation<br/>provider = ollama"]:::verify
        APPROVE{"Accountable approval?"}:::decision
        OUTBOX["PostgreSQL outbox<br/>knowledge.upsert"]:::service
        EMBED["Ollama embedding"]:::local
        MILVUS[("Milvus approved index<br/>PostgreSQL UUID")]:::vector
        READBACK{"RAG read-back returns<br/>promoted UUID?"}:::decision
        BLOCK["Remain at current gate<br/>retry · revise · reject"]:::reject
        DONE["Task completed<br/><b>activate next queued task</b>"]:::done
        REVISE --> VALIDATE
        CAPTURE -->|"RAG hit or local-only"| VALIDATE
        VALIDATE --> APPROVE
        APPROVE -- yes --> OUTBOX --> EMBED --> MILVUS --> READBACK
        APPROVE -- no --> BLOCK
        READBACK -- no --> BLOCK
        READBACK -- yes --> DONE
    end

    HEAD -- yes --> ACTIVATE
    HEAD -- no --> FIFO
    DONE --> FIFO

    NOTE["Raw cloud output is evidence, never knowledge.<br/><b>Only an Ollama-applied, locally validated, approved lesson is reusable.</b><br/>Review influence is provenance, not a truth score."]:::note
    RAW -.-> NOTE

