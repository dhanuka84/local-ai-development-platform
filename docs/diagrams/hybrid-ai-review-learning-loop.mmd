%%{init: {"theme":"base","themeVariables":{"fontFamily":"Arial, sans-serif","fontSize":"16px","primaryTextColor":"#14263d","lineColor":"#53677f","edgeLabelBackground":"#ffffff"},"flowchart":{"curve":"basis","htmlLabels":true,"nodeSpacing":28,"rankSpacing":40},"fontFamily":"Arial, sans-serif","themeCSS":".nodeLabel, .edgeLabel, .cluster-label, .flowchartTitleText { font-family: Arial, sans-serif !important; }"}}%%
flowchart TB
    QUEUE["workflow_task_begin<br/>durable FIFO queue"]:::client
    ACT["Activate only the queue head<br/>fresh RAG lookup + immutable evidence"]:::service
    ROUTE{"Approved strong hit<br/>or permitted miss?"}:::gate
    LOCAL["Ollama local implementation<br/>work packet + local verification<br/>generation_capture → pending KB entry"]:::local
    CLOUD["Allowed development miss only<br/>read-only Codex review<br/>exact output + disclosed-context manifest"]:::target
    REVISE["Apply accepted findings locally<br/>revise pending version<br/>retain new evidence"]:::local
    VALID["Trusted local work-packet validation<br/>exact candidate + source binding"]:::service
    USE{"Complete validated reuse<br/>or propose publication?"}:::gate
    REUSE["VALIDATED_REUSE_COMPLETED<br/>recheck eligible recorded context<br/>new KB entry stays pending"]:::done
    WAIT["promotion_required<br/>inspect exact candidate and validation<br/>wait for explicit user decision"]:::pending
    PUB["Approve exact version<br/>PostgreSQL decision + outbox transaction"]:::service
    INDEX["Worker embeds locally<br/>Milvus upsert under PostgreSQL UUID"]:::data
    BACK["RAG_READBACK_VERIFIED<br/>exact promoted UUID from Milvus"]:::service
    DONE["Completed<br/>activate next queued task"]:::done
    QUEUE --> ACT --> ROUTE --> LOCAL
    LOCAL -->|RAG hit or local-only miss| VALID
    LOCAL -->|policy-allowed development miss| CLOUD --> REVISE --> VALID
    VALID -->|pass| USE
    VALID -->|fail| REVISE
    USE -->|eligible context + validation ID| REUSE --> DONE
    USE -->|new knowledge| WAIT
    WAIT -->|user approves| PUB --> INDEX --> BACK --> DONE
    DONE -.-> QUEUE
    NOTE["Auto mode removes only optional review acceptance.<br/>Manual mode adds that gate before cloud review.<br/>Maintenance / protected data never enter the cloud lane.<br/>Independent work can continue while publication waits."]:::gate
    ROUTE -.- NOTE

