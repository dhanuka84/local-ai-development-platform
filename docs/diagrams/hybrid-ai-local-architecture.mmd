flowchart LR

    subgraph USERS["USER AND DEVELOPMENT SURFACES"]
        direction LR
        ENGINEER["Software engineer<br/>IDE · terminal · browser"]:::user
        CODEX["Codex CLI / IDE<br/>generation · review · capture hooks"]:::client
        ADMIN["Platform administrator<br/>approval · policy · recovery"]:::user
    end

    subgraph LOCAL["LOCAL TRUST BOUNDARY · GBX100"]
        direction TB

        subgraph AGENTS["AGENT AND ACCESS LAYER"]
            direction LR
            OPENCLAW_DEV["OpenClaw<br/>development coordinator"]:::control
            OPENCLAW_MAINT["OpenClaw<br/>maintenance agent<br/><b>local-only</b>"]:::maintenance
            MCP["Engineering MCP gateway<br/>typed tools · scoped tokens · audit"]:::gateway
            CLOUD_GUARD["Cloud disclosure gateway<br/>classify · minimize · redact · approve · inspect response"]:::security
            EGRESS_DENY["Maintenance egress denied<br/>no cloud credentials · fail closed"]:::security
        end

        subgraph SERVICES["APPLICATION SERVICES"]
            direction LR
            ROUTER["Model router<br/>task + policy + classification"]:::service
            RETRIEVAL["Knowledge retrieval<br/>hybrid search · ACL · graph expansion · rerank"]:::service
            CAPTURE["Capture worker<br/>normalize · redact · hash · extract patterns"]:::service
            REVIEW["Review and promotion<br/>candidate → validate → approve"]:::service
            INDEXER["Knowledge indexer<br/>chunk · embed · idempotent upsert"]:::service
            REPO["Knowledge + repository graph service<br/>transactions · typed edges · provenance · artifacts"]:::service
        end

        subgraph INFERENCE["LOCAL INFERENCE · OLLAMA"]
            direction LR
            CODER["Coding model<br/>development + maintenance"]:::model
            EMBED["Embedding model<br/>code + text vectors"]:::model
            RERANK["Local reranker / utility model"]:::model
        end

        subgraph DATA["LOCAL DATA PLANE"]
            direction LR
            PG[("PostgreSQL<br/><b>system of record</b><br/>workflow · provenance · outbox<br/>typed Git repository nodes + edges")]:::database
            MILVUS[("Milvus Standalone<br/><b>derived semantic index</b><br/>approved patterns + repository-relation evidence")]:::vector
            GIT[("Git repositories<br/><b>product source + approved knowledge</b><br/>revisions · patterns · ADRs · runbooks")]:::knowledge
            ARTIFACTS[("Content-addressed artifacts<br/>prompts · outputs · patches · evidence")]:::storage
            SPOOL[("Protected local spool<br/>non-blocking capture buffer")]:::storage
        end

        subgraph OPS["OPERATIONS AND SECURITY"]
            direction LR
            OBS["OpenTelemetry · Prometheus · Grafana<br/>traces · metrics · redacted logs"]:::ops
            SECRETS["Local secret store<br/>provider keys separated by role"]:::security
            BACKUP["Encrypted backup<br/>PostgreSQL · Git · artifacts · manifests"]:::ops
        end
    end

    subgraph CLOUD["EXTERNAL CLOUD TRUST BOUNDARY · DEVELOPMENT REVIEW ONLY"]
        direction LR
        KIMI["Moonshot API<br/>Kimi architecture / optimization review"]:::cloud
        OPENAI["OpenAI<br/>Codex code and diff review"]:::cloud
    end

    ENGINEER --> OPENCLAW_DEV
    ENGINEER --> CODEX
    ADMIN --> MCP
    CODEX <-->|"scoped MCP tools"| MCP
    OPENCLAW_DEV <-->|"agent tools"| MCP
    OPENCLAW_MAINT <-->|"restricted tools"| MCP

    OPENCLAW_DEV --> ROUTER
    OPENCLAW_MAINT -->|"maintenance requests"| ROUTER
    ROUTER -->|"normal development"| CODER
    ROUTER -->|"maintenance: mandatory"| CODER
    OPENCLAW_MAINT -.->|"hard control"| EGRESS_DENY

    MCP --> RETRIEVAL
    RETRIEVAL -->|"semantic + lexical candidates"| MILVUS
    RETRIEVAL -->|"authoritative records · exact repository graph"| REPO
    RETRIEVAL --> RERANK
    RERANK --> RETRIEVAL

    CODEX -->|"hook event"| SPOOL
    OPENCLAW_DEV -->|"run envelope"| SPOOL
    SPOOL --> CAPTURE
    CAPTURE -->|"candidate + evidence"| REPO
    CAPTURE -->|"pending candidate"| REVIEW
    REVIEW -->|"validated decision"| REPO
    REPO -->|"records + typed repo edges + outbox"| PG
    REPO -->|"approved knowledge + repository evidence"| GIT
    REPO -->|"immutable payloads"| ARTIFACTS
    REPO -->|"index job + approved revision"| INDEXER
    INDEXER --> EMBED
    EMBED --> INDEXER
    INDEXER -->|"knowledge + repository-relation vectors"| MILVUS

    ROUTER -->|"explicit escalation"| CLOUD_GUARD
    CODEX -.->|"approved scoped package"| CLOUD_GUARD
    CLOUD_GUARD -->|"architecture package"| KIMI
    CLOUD_GUARD -->|"code review package"| OPENAI
    CLOUD_GUARD -->|"advisory findings"| REVIEW
    SECRETS --> CLOUD_GUARD

    MCP -.-> OBS
    ROUTER -.-> OBS
    REPO -.-> OBS
    PG --> BACKUP
    GIT --> BACKUP
    ARTIFACTS --> BACKUP

