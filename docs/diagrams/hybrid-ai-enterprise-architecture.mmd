flowchart LR

    subgraph CLIENTS["CLIENT AND EDGE PLANE"]
        direction LR
        DEV["Developer workstations<br/>Codex · IDE · CLI"]:::user
        EDGE["Site / edge node<br/>OpenClaw · Ollama · local cache"]:::edge
        MAINT["Isolated maintenance runner<br/>local model · no internet egress"]:::maintenance
        CICD["CI/CD and repository events<br/>build · test · review triggers"]:::client
        PORTAL["Admin and review portal<br/>approval · policy · audit"]:::client
    end

    subgraph ENTERPRISE["PRIMARY ENTERPRISE REGION · KUBERNETES ACROSS AVAILABILITY ZONES"]
        direction TB

        subgraph ACCESS["ZERO-TRUST ACCESS LAYER"]
            direction LR
            WAF["Load balancer / WAF<br/>rate limit · request limits"]:::gateway
            IDP["Enterprise identity provider<br/>OIDC · MFA · groups"]:::identity
            MCP["Stateless MCP gateway replicas<br/>tool contracts · scoped authorization"]:::gateway
            API["Platform API gateway<br/>REST/events · tenant context"]:::gateway
        end

        subgraph CONTROL["AGENT CONTROL PLANE"]
            direction LR
            POLICY["Policy and data-classification engine<br/>tenant · purpose · residency · disclosure"]:::security
            OPENCLAW["OpenClaw agent coordinators<br/>development · review · maintenance profiles"]:::control
            WORKFLOW["Durable workflow service<br/>state machine · timeout · retry · idempotency"]:::control
            MODEL_GW["Model gateway<br/>routing · quota · cost · fallback policy"]:::control
            REVIEW["Review and knowledge promotion<br/>candidate · evidence · approval · publish"]:::service
        end

        subgraph ASYNC["EVENT AND WORKER PLANE"]
            direction LR
            RELAY["Transactional outbox relay"]:::service
            BUS["Durable event / job bus<br/>partitioned by tenant and workload"]:::event
            WORKERS["Sandboxed agent workers<br/>repository tools · build · test"]:::worker
            CAPTURE["Capture and redaction workers<br/>normalize · classify · hash"]:::worker
            INDEXER["Embedding and indexing workers<br/>chunk · embed · revisioned upsert"]:::worker
            EVAL["Evaluation workers<br/>retrieval quality · regression · safety"]:::worker
        end

        subgraph RETRIEVAL["KNOWLEDGE AND RETRIEVAL SERVICES"]
            direction LR
            QUERY["Knowledge + repository query service<br/>hybrid retrieve → ACL → exact graph → rerank"]:::service
            RERANK["Private reranking service"]:::model
            SYNC["Edge knowledge sync<br/>signed deltas · policy-filtered collections"]:::service
            REPO["Knowledge + repository graph service<br/>authoritative records · typed edges · provenance · artifact refs"]:::service
        end

        subgraph INFERENCE["INFERENCE PLANE"]
            direction LR
            PRIVATE_LLM["Private GPU inference cluster<br/>production model server · autoscaling"]:::model
            PRIVATE_EMBED["Embedding service<br/>versioned models and dimensions"]:::model
            EXPORT["Cloud disclosure gateway<br/>DLP · minimization · approval · egress allowlist"]:::security
            KIMI["Kimi cloud<br/>architecture and optimization review"]:::cloud
            OPENAI["OpenAI / Codex cloud<br/>code and diff review"]:::cloud
        end

        subgraph RECORD["AUTHORITATIVE DATA AND KNOWLEDGE PLANE"]
            direction LR
            PGBOUNCER["PgBouncer<br/>write/read pools"]:::database
            PGHA[("PostgreSQL HA<br/>primary + replicas<br/>workflow · typed Git repository graph<br/>provenance · audit · outbox")]:::database
            GIT[("Enterprise Git<br/>product source + approved knowledge<br/>patterns · ADRs · policies · runbooks")]:::knowledge
            OBJECT[("Versioned object storage<br/>artifacts · evidence · exports · WAL/PITR")]:::storage
        end

        subgraph VECTOR["DISTRIBUTED MILVUS RETRIEVAL PLANE"]
            direction LR
            MPROXY["Milvus proxies<br/>knowledge + repository-relation semantic index"]:::vector
            MCOORD["Coordinator HA"]:::vector
            MQUERY["Query nodes<br/>independent read scaling"]:::vector
            MDATA["Streaming + data nodes<br/>ingestion scaling"]:::vector
            META[("Metadata store<br/>etcd")]:::vectorStore
            MWAL[("Milvus WAL<br/>Woodpecker / approved backend")]:::vectorStore
            MOBJECT[("Vector object storage<br/>indexes · binlogs · snapshots")]:::vectorStore
        end

        subgraph PLATFORM["PLATFORM SECURITY AND OPERATIONS"]
            direction LR
            SECRETS["Secrets and key management<br/>rotation · workload identity · tenant keys"]:::security
            OTEL["OpenTelemetry collectors<br/>traces · metrics · redacted logs"]:::ops
            MONITOR["Prometheus · Grafana · alerting<br/>SLO · queue lag · index freshness · cost"]:::ops
            GITOPS["GitOps delivery<br/>signed images · SBOM · policy gates"]:::ops
            SIEM["Immutable audit export / SIEM"]:::ops
        end
    end

    subgraph DR["SECONDARY REGION · DISASTER RECOVERY / REGIONAL READ PLANE"]
        direction LR
        PGDR[("PostgreSQL replica cluster<br/>promotable by runbook")]:::dr
        OBJDR[("Replicated object storage<br/>versioning + retention")]:::dr
        MILVUSDR[("Regional Milvus cluster<br/>rebuild / replicated collections")]:::dr
        INFERDR["Regional private inference<br/>data-residency policy"]:::dr
    end

    DEV --> WAF
    EDGE --> WAF
    CICD --> WAF
    PORTAL --> WAF
    IDP -->|"identity + groups"| WAF
    WAF --> MCP
    WAF --> API
    MAINT -->|"local requests only"| EDGE

    MCP --> POLICY
    API --> POLICY
    POLICY --> OPENCLAW
    POLICY --> WORKFLOW
    OPENCLAW --> WORKFLOW
    WORKFLOW --> MODEL_GW
    WORKFLOW --> REVIEW
    WORKFLOW -->|"durable jobs"| BUS

    MODEL_GW -->|"private/default"| PRIVATE_LLM
    MODEL_GW -->|"approved cloud request"| EXPORT
    EXPORT --> KIMI
    EXPORT --> OPENAI

    MCP --> QUERY
    OPENCLAW --> QUERY
    QUERY --> MPROXY
    QUERY --> REPO
    QUERY --> RERANK
    RERANK --> QUERY
    REPO -->|"approved knowledge"| SYNC
    SYNC -->|"approved signed knowledge"| EDGE

    REPO -->|"transactions + outbox"| PGBOUNCER
    REPO -->|"approved documents"| GIT
    REPO -->|"artifacts + evidence"| OBJECT
    PGBOUNCER --> PGHA
    PGHA -->|"committed outbox"| RELAY
    RELAY --> BUS
    BUS --> WORKERS
    BUS --> CAPTURE
    BUS --> INDEXER
    BUS --> EVAL
    WORKERS -->|"run state + evidence refs"| REPO
    CAPTURE -->|"normalized candidates"| REPO
    EVAL -->|"quality and safety results"| REPO
    REVIEW -->|"decision + approved revision"| REPO
    REPO -->|"approved knowledge + repository relations"| INDEXER
    INDEXER --> PRIVATE_EMBED
    INDEXER --> MPROXY

    MPROXY --> MQUERY
    MPROXY --> MDATA
    MCOORD --> MQUERY
    MCOORD --> MDATA
    MCOORD --> META
    MDATA --> MWAL
    MDATA --> MOBJECT
    MQUERY --> MOBJECT

    SECRETS --> MCP
    SECRETS --> MODEL_GW
    MCP -.-> OTEL
    WORKFLOW -.-> OTEL
    QUERY -.-> OTEL
    MODEL_GW -.-> OTEL
    OTEL --> MONITOR
    PGHA -->|"append-only audit"| SIEM
    GITOPS -.-> MCP
    GITOPS -.-> API

    PGHA -->|"streaming/WAL archive"| PGDR
    OBJECT -->|"cross-region replication"| OBJDR
    MOBJECT -->|"snapshot/rebuild source"| MILVUSDR
    PRIVATE_LLM -.->|"regional deployment profile"| INFERDR

