# Copy to .env and replace every value marked CHANGE_ME.
APP_ENV=local
LOG_LEVEL=info
AUTH_TOKEN=CHANGE_ME_generate_a_long_random_token
CONTROLLER_AUTH_TOKEN=CHANGE_ME_generate_a_different_long_random_token
POSTGRES_PASSWORD=CHANGE_ME_local_database_password

# The legacy token bootstraps one solo human principal with all four roles.
# For separate human/controller/agent credentials, replace it operationally
# with AUTH_PRINCIPALS_JSON as documented in docs/operations.md.
AUTH_PRINCIPAL_ID=human:local-developer
AUTH_PRINCIPAL_ROLES=development,qa,product_owner,operations
AUTH_PRINCIPAL_PROJECTS=*
CONTROLLER_AUTH_PROJECTS=*

# Cerbos is the local contextual authorization PDP. The Compose profile enables
# it explicitly; direct local binaries may use AUTHORIZATION_MODE=none only for
# development tests that do not perform autonomous protected actions.
AUTHORIZATION_MODE=cerbos
CERBOS_REQUEST_TIMEOUT=2s

# Ollama models. The repository pulls only the small embedding model by default.
OLLAMA_EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSION=768
LOCAL_CHAT_MODEL=qwen3.6:35b

# Safety defaults: knowledge requires explicit approval before retrieval.
AUTO_APPROVE_LOCAL=false
SEARCH_LEXICAL_FALLBACK=true

# Repository exposed read-only to the local analyzer-enabled MCP gateway.
# Use an absolute path when indexing a repository outside this checkout.
CODEGRAPH_ENABLED=true
CODEGRAPH_HOST_ROOT=../..
CODEGRAPH_MAX_FILES=5000
CODEGRAPH_MAX_ENTITIES=200000
CODEGRAPH_MAX_RELATIONS=1000000
CODEGRAPH_JVM_INDEXER_COMMAND=/usr/local/bin/hybrid-index-jvm
CODEGRAPH_TYPESCRIPT_INDEXER_COMMAND=/usr/local/bin/hybrid-index-typescript
CODEGRAPH_PYTHON_INDEXER_COMMAND=/usr/local/bin/hybrid-index-python
